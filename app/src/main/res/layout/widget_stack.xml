<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <StackView android:id="@+id/all_accounts_stack" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center" android:loopViews="true"/>
    <TextView android:id="@+id/stack_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="18dp" android:text="@string/widget_no_accounts"
        android:background="@drawable/widget_bg_light" android:textColor="#6853A6" android:textSize="14sp"/>
</FrameLayout>
