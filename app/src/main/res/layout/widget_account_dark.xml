<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_glass" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg_dark" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="top" android:padding="13dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_logo" android:layout_width="32dp" android:layout_height="32dp"
            android:scaleType="fitCenter" android:src="@drawable/portrait" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_ai" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_name" android:textColor="#F2EEFC" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            <TextView android:id="@+id/widget_account_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_choose" android:textColor="#B0A9C2" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_page_controls" android:layout_width="wrap_content"
            android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginStart="4dp" android:visibility="gone">
            <ImageView android:id="@+id/widget_page_prev" android:layout_width="28dp" android:layout_height="32dp"
                android:padding="4dp" android:src="@drawable/ic_chevron" android:rotation="180"
                android:tint="#C7B4FF" android:contentDescription="@string/widget_page_previous"
                android:background="?android:attr/selectableItemBackground"/>
            <TextView android:id="@+id/widget_page_index" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C7B4FF" android:textSize="11sp" android:fontFeatureSettings="tnum"
                android:singleLine="true" android:includeFontPadding="false"/>
            <ImageView android:id="@+id/widget_page_next" android:layout_width="28dp" android:layout_height="32dp"
                android:padding="4dp" android:src="@drawable/ic_chevron" android:tint="#C7B4FF"
                android:contentDescription="@string/widget_page_next" android:background="?android:attr/selectableItemBackground"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_short" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_short_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#F2EEFC" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            <Chronometer android:id="@+id/widget_short_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textColor="#C7B4FF" android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:countDown="true"/>
            <TextView android:id="@+id/widget_short_static" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textColor="#C7B4FF" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_short_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="#B0A9C2" android:textSize="10sp"
            android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        <ProgressBar android:id="@+id/widget_short_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp"
            android:indeterminate="false" android:max="10000" android:minHeight="3dp"
            android:progressDrawable="@drawable/widget_progress_dark"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_week" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_week_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#F2EEFC" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            <Chronometer android:id="@+id/widget_week_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textColor="#C7B4FF" android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:countDown="true"/>
            <TextView android:id="@+id/widget_week_static" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textColor="#C7B4FF" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:singleLine="true" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_week_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="#B0A9C2" android:textSize="10sp"
            android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        <ProgressBar android:id="@+id/widget_week_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp"
            android:indeterminate="false" android:max="10000" android:minHeight="3dp"
            android:progressDrawable="@drawable/widget_progress_dark"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/widget_description"
        android:textColor="#B0A9C2" android:textSize="12sp" android:maxLines="3"/>
    </LinearLayout>
</FrameLayout>
