<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ListView android:id="@+id/all_accounts_list" android:layout_width="match_parent"
        android:layout_height="match_parent" android:divider="@android:color/transparent"
        android:dividerHeight="6dp" android:scrollbars="none" android:overScrollMode="never"
        android:requiresFadingEdge="vertical" android:fadingEdgeLength="10dp"
        android:cacheColorHint="@android:color/transparent" android:listSelector="@android:color/transparent"
        android:clipToPadding="true" android:padding="0dp" android:transcriptMode="disabled" android:keepScreenOn="false"/>
    <TextView android:id="@+id/deck_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="18dp" android:text="@string/widget_deck_loading"
        android:background="@drawable/widget_bg_light" android:textColor="#6853A6" android:textSize="14sp"/>
</FrameLayout>
